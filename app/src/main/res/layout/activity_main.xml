<?xml version="1.0" encoding="utf-8"?>
<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/tabhost" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
            <TabWidget android:id="@android:id/tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </HorizontalScrollView>
        <FrameLayout android:id="@android:id/tabcontent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <include layout="@layout/tab_registration" />
            <ScrollView android:id="@+id/rules_tab" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                <TextView android:id="@+id/rules_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:textSize="18sp" />
            </ScrollView>
            <ListView android:id="@+id/authors_list" android:layout_width="match_parent" android:layout_height="match_parent" />
            <include layout="@layout/tab_settings" />
        </FrameLayout>
    </LinearLayout>
</TabHost>
