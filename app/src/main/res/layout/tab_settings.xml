<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/settings_tab" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:id="@+id/game_speed_label" style="@style/FormLabel" android:labelFor="@id/game_speed" />
<SeekBar android:id="@+id/game_speed" android:layout_width="match_parent" android:layout_height="48dp" android:max="9" android:contentDescription="@string/game_speed" />
<TextView android:id="@+id/max_cockroaches_label" style="@style/FormLabel" android:labelFor="@id/max_cockroaches" />
<SeekBar android:id="@+id/max_cockroaches" android:layout_width="match_parent" android:layout_height="48dp" android:max="29" android:contentDescription="@string/max_cockroaches" />
<TextView android:id="@+id/bonus_interval_label" style="@style/FormLabel" android:labelFor="@id/bonus_interval" />
<SeekBar android:id="@+id/bonus_interval" android:layout_width="match_parent" android:layout_height="48dp" android:max="59" android:contentDescription="@string/bonus_interval" />
<TextView android:id="@+id/round_duration_label" style="@style/FormLabel" android:labelFor="@id/round_duration" />
<SeekBar android:id="@+id/round_duration" android:layout_width="match_parent" android:layout_height="48dp" android:max="59" android:contentDescription="@string/round_duration" />
</LinearLayout>
</ScrollView>
